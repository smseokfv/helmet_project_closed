<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/myCamera"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_margin="0dp">

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/serverCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/viewOptRes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="서버 IP주소 : \n등록 ID : " />

    <TextView
        android:id="@+id/viewSSID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="SSID : " />

    <TextView
        android:id="@+id/viewUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="사용자 아이디 : " />

    <TextView
        android:id="@+id/viewUserPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:text="사용자 비밀번호 : " />

     <Button
        android:id="@+id/btnOptSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="설정하기" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="(ver.1.3)" />

</LinearLayout>